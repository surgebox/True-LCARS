import QtQuick
import QtQuick.Shapes
import QtQuick.Effects
import "../theme"

// ---------------------------------------------------------------------------
// LcarsElbow - the shape the whole LCARS language is built on.
//
//   ╭──────────────────────┐
//   │                      │        outerRadius = the screen-edge corner
//   │  ╭───────────────────┘        innerRadius = the concave shoulder where
//   │  │                                         the two arms meet
//   │  │
//
// The geometry is authored once in the top-left orientation and then mirrored
// per point for the other three corners. Mirroring also inverts arc sweep, so
// the sweep flags flip with it - that keeps all four orientations generated by
// exactly one code path instead of relying on an item transform.
//
//   barThickness    - how tall the horizontal arm is
//   columnThickness - how wide the vertical arm is
//
// `glass` applies the same backlit-pane treatment as LcarsRect; see that file
// for what each layer is doing.
// ---------------------------------------------------------------------------
Shape {
    id: root

    property color color: "#ff9c00"
    property string corner: "topLeft" // topLeft | topRight | bottomLeft | bottomRight
    property real barThickness: 46
    property real columnThickness: 176
    property real outerRadius: 46
    property real innerRadius: 26

    property bool glass: LcarsUi.glass
    property real gloss: 0.20
    property real glow: 0.30

    preferredRendererType: Shape.CurveRenderer
    asynchronous: false
    antialiasing: true

    readonly property bool flipH: corner === "topRight" || corner === "bottomRight"
    readonly property bool flipV: corner === "bottomLeft" || corner === "bottomRight"

    // clamped geometry
    readonly property real bt: Math.max(1, Math.min(barThickness, height))
    readonly property real ct: Math.max(1, Math.min(columnThickness, width))
    readonly property real ro: Math.max(0, Math.min(outerRadius, Math.min(ct, bt)))
    readonly property real ri: Math.max(0, Math.min(innerRadius, Math.min(width - ct, height - bt)))

    // ---- material ----------------------------------------------------------
    readonly property real depth: LcarsUi.glassDepth(height)
    readonly property color face: glass ? LcarsUi.glassFace(color) : color
    readonly property color faceTop:
        glass ? LcarsUi.mix(face, LcarsUi.glassHi(color), depth) : color
    readonly property color faceBottom:
        glass ? LcarsUi.mix(face, LcarsUi.glassLo(color), depth) : color
    // the highlight and shadow bands are a fixed depth rather than a fixed
    // fraction, so every block is lit the same way regardless of its height
    readonly property real hiStop:
        Math.max(0.02, Math.min(0.5, LcarsUi.u(22) / Math.max(1, height)))
    readonly property real loStop: Math.max(hiStop + 0.02, 1 - LcarsUi.u(16) / Math.max(1, height))

    layer.enabled: glass
    layer.effect: MultiEffect {
        autoPaddingEnabled: true
        blurEnabled: true
        blur: 0.05
        blurMax: 20
        shadowEnabled: true
        shadowColor: LcarsUi.glassGlow(root.color, root.glow)
        shadowBlur: 0.55
        shadowHorizontalOffset: 0
        shadowVerticalOffset: 0
    }

    function pathString() {
        const w = width
        const h = height
        const t = root.bt
        const c = root.ct
        const o = root.ro
        const i = root.ri
        const fh = root.flipH
        const fv = root.flipV

        function X(x) { return fh ? w - x : x }
        function Y(y) { return fv ? h - y : y }
        // a mirrored arc runs the other way round
        const s1 = (fh !== fv) ? 0 : 1
        const s2 = 1 - s1

        let p = "M " + X(0) + " " + Y(h) + " "
        p += "L " + X(0) + " " + Y(o) + " "
        if (o > 0)
            p += "A " + o + " " + o + " 0 0 " + s1 + " " + X(o) + " " + Y(0) + " "
        p += "L " + X(w) + " " + Y(0) + " "
        p += "L " + X(w) + " " + Y(t) + " "
        p += "L " + X(c + i) + " " + Y(t) + " "
        if (i > 0)
            p += "A " + i + " " + i + " 0 0 " + s2 + " " + X(c) + " " + Y(t + i) + " "
        p += "L " + X(c) + " " + Y(h) + " "
        p += "Z"
        return p
    }

    // ---- the pane ----------------------------------------------------------
    ShapePath {
        fillGradient: LinearGradient {
            x1: 0
            y1: 0
            x2: 0
            y2: root.height
            GradientStop { position: 0.00; color: root.faceTop }
            GradientStop { position: root.hiStop; color: root.face }
            GradientStop { position: root.loStop; color: root.face }
            GradientStop { position: 1.00; color: root.faceBottom }
        }
        strokeColor: "transparent"
        strokeWidth: 0
        PathSvg { path: root.pathString() }
    }

    // ---- the reflection ----------------------------------------------------
    ShapePath {
        fillGradient: LinearGradient {
            x1: 0
            y1: 0
            x2: 0
            y2: root.height
            GradientStop {
                position: 0.00
                color: root.glass ? Qt.rgba(1, 1, 1, root.gloss * root.depth) : "transparent"
            }
            GradientStop { position: 0.34; color: "transparent" }
        }
        PathSvg { path: root.pathString() }
    }
}
