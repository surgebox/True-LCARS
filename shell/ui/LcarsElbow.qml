import QtQuick
import QtQuick.Shapes

// ---------------------------------------------------------------------------
// LcarsElbow - the shape the whole LCARS language is built on.
//
//   ╭──────────────────────┐
//   │                      │        outerRadius = the screen-edge corner
//   │  ╭───────────────────┘        innerRadius = the concave shoulder where
//   │  │                                         the two arms meet
//   │  │
//
// The geometry is authored once in the top-left orientation and then mirrored
// per point for the other three corners. Mirroring also inverts arc sweep, so
// the sweep flags flip with it - that keeps all four orientations generated by
// exactly one code path instead of relying on an item transform.
//
//   barThickness    - how tall the horizontal arm is
//   columnThickness - how wide the vertical arm is
// ---------------------------------------------------------------------------
Shape {
    id: root

    property color color: "#ff9c00"
    property string corner: "topLeft" // topLeft | topRight | bottomLeft | bottomRight
    property real barThickness: 46
    property real columnThickness: 176
    property real outerRadius: 46
    property real innerRadius: 26

    // Optional transition at the arm's far end, filleted rather than a hard
    // corner. Two directions, and the one you want depends on which side the
    // fillet should live on:
    //
    //   armEndThickness < barThickness   the arm steps DOWN, its own corner
    //                                    rounded off
    //   armEndThickness > barThickness   the arm FLARES UP to meet something
    //                                    thicker, with a concave fillet that
    //                                    fills the re-entrant corner - the same
    //                                    curve the shoulder uses
    //
    // 0 leaves the arm at its full thickness.
    //
    // Mirroring handles the side for free - the "far end" is the right end for
    // topLeft/bottomLeft and the left end for topRight/bottomRight, so the same
    // shape serves both ends of a run.
    property real armEndThickness: 0
    property real armEndRadius: 0

    preferredRendererType: Shape.CurveRenderer
    asynchronous: false
    antialiasing: true

    readonly property bool flipH: corner === "topRight" || corner === "bottomRight"
    readonly property bool flipV: corner === "bottomLeft" || corner === "bottomRight"

    // clamped geometry
    readonly property real bt: Math.max(1, Math.min(barThickness, height))
    readonly property real ct: Math.max(1, Math.min(columnThickness, width))
    readonly property real ro: Math.max(0, Math.min(outerRadius, Math.min(ct, bt)))
    readonly property real ri: Math.max(0, Math.min(innerRadius, Math.min(width - ct, height - bt)))

    // arm end transition
    readonly property real et: armEndThickness > 0 ? armEndThickness : bt
    readonly property real er:
        (armEndThickness > 0)
        ? Math.max(0, Math.min(armEndRadius, Math.abs(et - bt)))
        : 0

    function pathString() {
        const w = width
        const h = height
        const t = root.bt
        const c = root.ct
        const o = root.ro
        const i = root.ri
        const fh = root.flipH
        const fv = root.flipV

        function X(x) { return fh ? w - x : x }
        function Y(y) { return fv ? h - y : y }
        // a mirrored arc runs the other way round
        const s1 = (fh !== fv) ? 0 : 1
        const s2 = 1 - s1

        let p = "M " + X(0) + " " + Y(h) + " "
        p += "L " + X(0) + " " + Y(o) + " "
        if (o > 0)
            p += "A " + o + " " + o + " 0 0 " + s1 + " " + X(o) + " " + Y(0) + " "
        p += "L " + X(w) + " " + Y(0) + " "
        // down the arm's far end, then whichever fillet it asked for
        p += "L " + X(w) + " " + Y(et) + " "
        if (er > 0 && et < t) {
            // steps down: the arm's own corner is rounded off
            p += "A " + er + " " + er + " 0 0 " + s1 + " " + X(w - er) + " " + Y(et + er) + " "
            if (et + er < t)
                p += "L " + X(w - er) + " " + Y(t) + " "
        } else if (et > t) {
            // Flares up: a concave fillet fills the re-entrant corner, so the
            // thick end stays square and the thin body sweeps out to meet it.
            //
            // The radius has to be the whole step, not whatever was asked for -
            // the arc is only tangent to both the end and the bottom edge when
            // it spans exactly that, and a short arc just leaves a lump.
            const fr = et - t
            p += "A " + fr + " " + fr + " 0 0 " + s2 + " " + X(w - fr) + " " + Y(t) + " "
        }
        p += "L " + X(c + i) + " " + Y(t) + " "
        if (i > 0)
            p += "A " + i + " " + i + " 0 0 " + s2 + " " + X(c) + " " + Y(t + i) + " "
        p += "L " + X(c) + " " + Y(h) + " "
        p += "Z"
        return p
    }

    ShapePath {
        fillColor: root.color
        strokeColor: "transparent"
        strokeWidth: 0
        PathSvg { path: root.pathString() }
    }
}
